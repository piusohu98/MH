<Window x:Class="MH.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MH.Client.Controls"
        xmlns:viewModels="clr-namespace:MH.Client.ViewModels"
        Title="MH 市场监控"
        Width="1180"
        Height="760"
        MinWidth="960"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="#0B1220"
        Foreground="#E5E7EB"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="#162033" />
            <Setter Property="BorderBrush" Value="#263653" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#94A3B8" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinWidth" Value="180" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Margin" Value="0,5,16,0" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Margin" Value="0,5,16,0" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="Margin" Value="0,5,0,0" />
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#3B82F6" />
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock FontSize="26" FontWeight="SemiBold" Text="MH 市场监控" />
                <TextBlock Margin="0,4,0,0" Style="{StaticResource MutedText}" Text="只读研究工具 · 仅展示人工决策参考，不自动买卖" />
            </StackPanel>
            <Border Grid.Column="1" Padding="14,8" CornerRadius="8">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#334155" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding State}" Value="{x:Static viewModels:MarketViewState.Loading}">
                                <Setter Property="Background" Value="#164E63" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="{x:Static viewModels:MarketViewState.Ready}">
                                <Setter Property="Background" Value="#14532D" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="{x:Static viewModels:MarketViewState.Offline}">
                                <Setter Property="Background" Value="#78350F" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="{x:Static viewModels:MarketViewState.Error}">
                                <Setter Property="Background" Value="#7F1D1D" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsStale}" Value="True">
                                <Setter Property="Background" Value="#854D0E" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource MutedText}" Text="状态  " />
                    <TextBlock FontWeight="SemiBold" Text="{Binding StatusText}" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="1.7*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Style="{StaticResource MutedText}" Text="区服" />
                    <ComboBox IsEnabled="{Binding CanInitialize}"
                              ItemsSource="{Binding Servers}"
                              DisplayMemberPath="Name"
                              SelectedValuePath="Id"
                              SelectedValue="{Binding SelectedServerId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Style="{StaticResource MutedText}" Text="商品" />
                    <ComboBox IsEnabled="{Binding CanInitialize}"
                              ItemsSource="{Binding Items}"
                              DisplayMemberPath="Name"
                              SelectedValuePath="Id"
                              SelectedValue="{Binding SelectedItemId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource MutedText}" Text="查看截止时间（UTC，通常无需修改）" />
                    <TextBox IsEnabled="{Binding CanInitialize}"
                             Text="{Binding SelectedAsOfUtcText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock FontSize="11" Foreground="#FCA5A5" Text="{Binding AsOfInputError}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <Button Click="InitializeButton_Click" IsEnabled="{Binding CanInitialize}" Content="重新加载目录" />
                    <Button Margin="8,5,0,0" Click="RefreshButton_Click" IsEnabled="{Binding CanRefresh}" Content="刷新行情" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Foreground="#FCA5A5" Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBlock Style="{StaticResource MutedText}" Text="最后更新：" />
                <TextBlock Style="{StaticResource MutedText}" Text="{Binding LastSuccessfulText}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.25*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock FontSize="17" FontWeight="SemiBold" Text="当前参考价" />
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource MutedText}" Text="最近完成采集日线" />
                            </DockPanel>
                            <TextBlock FontSize="36" FontWeight="SemiBold" Foreground="#F8FAFC" Text="{Binding CurrentReferencePriceText}" />
                            <TextBlock Margin="0,4,0,0" Style="{StaticResource MutedText}" Text="当日最低 ~ 最高" />
                            <TextBlock Margin="0,2,0,0" FontSize="17" Text="{Binding LatestRangeText}" />
                            <TextBlock Margin="0,12,0,0" Text="{Binding RelativePriceText}" TextWrapping="Wrap" />
                            <TextBlock Margin="0,8,0,0" Style="{StaticResource MutedText}" Text="采集截止（UTC）" />
                            <TextBlock Text="{Binding PriceCollectionCutoffText}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,4">
                                <TextBlock FontSize="17" FontWeight="SemiBold" Text="价格走势（最近采集日线）" />
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource MutedText}" Text="{Binding SelectedAsOfDisplayText}" />
                            </DockPanel>
                            <TextBlock Margin="0,0,0,10" Style="{StaticResource MutedText}" Text="用于观察价格方向；红点表示识别结果可能有误，虚线是近 7 天常见价，淡色背景表示节日或供给变化。" TextWrapping="Wrap" />
                            <controls:PriceChart Height="270"
                                                  Bars="{Binding Snapshot.Series.Bars}"
                                                  CommonPrice7Days="{Binding Snapshot.Indicators.RobustMedian7Days}"
                                                  Events="{Binding Snapshot.RelevantEvents}" />
                            <TextBlock Margin="0,10,0,0" Style="{StaticResource MutedText}" Text="{Binding OcrAnomalyText}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock FontSize="17" FontWeight="SemiBold" Text="活动观察" />
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource MutedText}" Text="单次历史比较" />
                            </DockPanel>
                            <TextBlock FontSize="19" FontWeight="SemiBold" Text="{Binding FocusEventTitleText}" TextWrapping="Wrap" />
                            <TextBlock Margin="0,4,0,0" Style="{StaticResource MutedText}" Text="{Binding FocusEventPeriodText}" TextWrapping="Wrap" />
                            <TextBlock Margin="0,4,0,0" Text="{Binding FocusEventStatusText}" />
                            <TextBlock Margin="0,6,0,0" Foreground="#FCA5A5" Text="{Binding EventResearchErrorText}" TextWrapping="Wrap" />
                            <UniformGrid Columns="2" Margin="0,12,0,0">
                                <Border Margin="0,0,8,8" Padding="10" Background="#1E2A40" CornerRadius="6">
                                    <TextBlock Text="{Binding DuringPriceImpactText}" TextWrapping="Wrap" />
                                </Border>
                                <Border Margin="0,0,0,8" Padding="10" Background="#1E2A40" CornerRadius="6">
                                    <TextBlock Text="{Binding DuringSupplyImpactText}" TextWrapping="Wrap" />
                                </Border>
                                <Border Margin="0,0,8,8" Padding="10" Background="#1E2A40" CornerRadius="6">
                                    <TextBlock Text="{Binding AfterPriceImpactText}" TextWrapping="Wrap" />
                                </Border>
                                <Border Margin="0,0,0,8" Padding="10" Background="#1E2A40" CornerRadius="6">
                                    <TextBlock Text="{Binding AfterSupplyImpactText}" TextWrapping="Wrap" />
                                </Border>
                            </UniformGrid>
                            <TextBlock Margin="0,2,0,0" Style="{StaticResource MutedText}" Text="样本说明" />
                            <TextBlock Margin="0,4,0,0" Text="{Binding EventEvidenceText}" TextWrapping="Wrap" />
                            <TextBlock Margin="0,10,0,0" Style="{StaticResource MutedText}" Text="活动日历（最多 5 项）" />
                            <TextBlock Margin="0,4,0,0" Text="{Binding EventCalendarText}" TextWrapping="Wrap" />
                            <TextBlock Margin="0,10,0,0" Style="{StaticResource MutedText}" Text="{Binding EventResearchNoticeText}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Margin="0,0,0,10" FontSize="17" FontWeight="SemiBold" Text="玩家速览" />
                            <UniformGrid Columns="2">
                                <Border Margin="0,0,8,8" Padding="10" Background="#1E2A40" CornerRadius="6">
                                    <TextBlock Text="{Binding PriceChange7Text}" TextWrapping="Wrap" />
                                </Border>
                                <Border Margin="0,0,0,8" Padding="10" Background="#1E2A40" CornerRadius="6">
                                    <TextBlock Text="{Binding PriceStability7Text}" TextWrapping="Wrap" />
                                </Border>
                                <Border Margin="0,0,8,0" Padding="10" Background="#1E2A40" CornerRadius="6">
                                    <TextBlock Text="{Binding SupplyChange7Text}" TextWrapping="Wrap" />
                                </Border>
                                <Border Margin="0,0,0,0" Padding="10" Background="#1E2A40" CornerRadius="6">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource MutedText}" Text="数据新鲜度" />
                                        <TextBlock FontSize="16" Text="{Binding DataAgeText}" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <Expander Header="查看分析依据（进阶）" Foreground="#CBD5E1" Background="#162033" Margin="0,0,0,12">
                        <StackPanel Margin="12">
                            <TextBlock Style="{StaticResource MutedText}" Text="近 30 天常见价（已尽量排除异常采集）" />
                            <TextBlock Text="{Binding Median30Text}" />
                            <TextBlock Margin="0,8,0,0" Style="{StaticResource MutedText}" Text="价格变化原始值（7 / 30 日）" />
                            <TextBlock Text="{Binding Return7Text, StringFormat=7 日：{0}}" />
                            <TextBlock Text="{Binding Return30Text, StringFormat=30 日：{0}}" />
                            <TextBlock Margin="0,8,0,0" Style="{StaticResource MutedText}" Text="价格波动原始值（越低通常越稳定，7 / 30 日）" />
                            <TextBlock Text="{Binding Volatility7Text, StringFormat=7 日：{0}}" />
                            <TextBlock Text="{Binding Volatility30Text, StringFormat=30 日：{0}}" />
                            <TextBlock Margin="0,8,0,0" Style="{StaticResource MutedText}" Text="采集到的在售数量变化（不是官方成交量，7 / 30 日）" />
                            <TextBlock Text="{Binding Supply7Text, StringFormat=7 日：{0}}" />
                            <TextBlock Text="{Binding Supply30Text, StringFormat=30 日：{0}}" />
                            <TextBlock Margin="0,8,0,0" Style="{StaticResource MutedText}" Text="识别质量提示（OCR）" />
                            <TextBlock Text="{Binding OcrAnomalyText}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock FontSize="17" FontWeight="SemiBold" Text="囤货参考" />
                        <Border Margin="0,12,0,14" Padding="14" Background="#1E3A5F" CornerRadius="8">
                            <StackPanel>
                                <TextBlock Style="{StaticResource MutedText}" Text="给玩家的建议" />
                                <TextBlock Margin="0,3,0,0" FontSize="25" FontWeight="SemiBold" Text="{Binding ActionText}" />
                                <TextBlock Margin="0,8,0,0" FontSize="16" Text="{Binding ReferenceLevelText}" />
                                <TextBlock Margin="0,5,0,0" Text="{Binding ActionabilityText}" TextWrapping="Wrap" />
                                <TextBlock Margin="0,10,0,0" Style="{StaticResource MutedText}" Text="{Binding MaxSuggestedPositionText}" />
                            </StackPanel>
                        </Border>
                        <TextBlock Margin="0,0,0,4" FontWeight="SemiBold" Text="为什么这样判断" />
                        <TextBlock Text="{Binding ReasonsText}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,14,0,4" FontWeight="SemiBold" Text="什么情况下不再适用" />
                        <TextBlock Text="{Binding InvalidationConditionsText}" TextWrapping="Wrap" />
                        <Expander Header="查看分析依据（进阶）" Foreground="#CBD5E1" Background="#162033" Margin="0,16,0,0">
                            <StackPanel Margin="12">
                                <TextBlock Style="{StaticResource MutedText}" Text="安全门禁" />
                                <TextBlock Text="{Binding GateStatusText}" />
                                <TextBlock Margin="0,8,0,0" Style="{StaticResource MutedText}" Text="规则版本 / 门禁版本" />
                                <TextBlock Text="{Binding RuleVersion}" />
                                <TextBlock Text="{Binding GateVersion}" />
                                <TextBlock Margin="0,8,0,0" Style="{StaticResource MutedText}" Text="方向分数 / 原始置信度" />
                                <TextBlock Text="{Binding DirectionScoreText}" />
                                <TextBlock Text="{Binding ConfidenceText}" />
                                <TextBlock Margin="0,8,0,0" Style="{StaticResource MutedText}" Text="目标最大占用金币比例" />
                                <TextBlock Text="{Binding MaxSuggestedPositionText}" />
                                <TextBlock Margin="0,8,0,0" Style="{StaticResource MutedText}" Text="历史模拟摘要" />
                                <TextBlock Text="{Binding GateSummaryText}" TextWrapping="Wrap" />
                                <TextBlock Margin="0,8,0,0" Style="{StaticResource MutedText}" Text="研究提示" />
                                <TextBlock Text="{Binding ResearchNoticeText}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <TextBlock Grid.Row="4" Margin="0,14,0,0" Style="{StaticResource MutedText}" Text="价格来自模拟/最近采集样本，不是游戏官方实时最低价；工具不会自动买卖。" />
    </Grid>
</Window>
